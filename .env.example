# ============================================================
# Tokayer Hub: משתני סביבה
# מעתיקים ל-.env.local (פיתוח) או מגדירים ב-Vercel > Settings > Environment Variables
# אין לשמור כאן ערכים אמיתיים. הקובץ הזה נכנס ל-git.
# ============================================================

# כתובת האתר בפרודקשן (בלי / בסוף). משמשת ל-SEO, Open Graph ו-sitemap
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# המפתח הציבורי (anon / publishable). בטוח לחשיפה בדפדפן, ההגנה היא ה-RLS בבסיס הנתונים
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# אופציונלי: מגביל את מסך הבחירה של Google לדומיין הארגוני (למשל tokayer.org.il).
# זו נוחות בלבד. ההרשאה בפועל נקבעת בטבלת access_allowlist ובפרופיל המשתמש.
NEXT_PUBLIC_GOOGLE_HOSTED_DOMAIN=

# מצב הדגמה: מאפשר לראות את אזור הצוות עם נתוני דוגמה בלי Supabase.
# פועל רק כש-Supabase לא מוגדר. להשאיר false בפרודקשן.
NEXT_PUBLIC_DEMO_MODE=false
